<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReelClean.Views.ConfirmWindow"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Rename files">
	<StackPanel Margin="20" Spacing="16">
		<TextBlock x:Name="MessageText" TextWrapping="Wrap" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="Cancel" MinWidth="88" IsCancel="True" Click="Cancel_Click" />
			<Button Content="Rename" MinWidth="88" IsDefault="True" Click="Confirm_Click" />
		</StackPanel>
	</StackPanel>
</Window>
