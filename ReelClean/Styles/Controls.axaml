<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

	<Style Selector="Window">
		<Setter Property="FontFamily" Value="Inter, $Default" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
		<Setter Property="Background" Value="{DynamicResource Brush.App}" />
		<Setter Property="UseLayoutRounding" Value="True" />
	</Style>

	<Style Selector="TextBlock.pageTitle">
		<Setter Property="FontSize" Value="26" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
		<Setter Property="LetterSpacing" Value="-0.4" />
	</Style>

	<Style Selector="TextBlock.sectionTitle">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
	</Style>

	<Style Selector="TextBlock.eyebrow">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
		<Setter Property="LetterSpacing" Value="0.4" />
	</Style>

	<Style Selector="TextBlock.kicker">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
		<Setter Property="LetterSpacing" Value="1.1" />
	</Style>

	<Style Selector="TextBlock.muted">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="LineHeight" Value="20" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<Style Selector="TextBlock.caption">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<Style Selector="TextBlock.trim">
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="TextWrapping" Value="NoWrap" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="TextBlock.proposed">
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<Style Selector="Border.card">
		<Setter Property="Background" Value="{DynamicResource Brush.Card}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
		<Setter Property="Padding" Value="20" />
		<Setter Property="BoxShadow" Value="0 10 28 -14 #99060A14" />
	</Style>

	<Style Selector="Border.card.dense">
		<Setter Property="Padding" Value="14,14" />
	</Style>

	<Style Selector="Border.well">
		<Setter Property="Background" Value="{DynamicResource Brush.Input}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
		<Setter Property="Padding" Value="12,10" />
	</Style>

	<Style Selector="Border.badge">
		<Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
		<Setter Property="CornerRadius" Value="{DynamicResource Radius.Badge}" />
		<Setter Property="Padding" Value="10,3" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="Border.badge TextBlock">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
	</Style>

	<Style Selector="Border.badge.success">
		<Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
	</Style>
	<Style Selector="Border.badge.success TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
	</Style>

	<Style Selector="Border.badge.warning">
		<Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
	</Style>
	<Style Selector="Border.badge.warning TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
	</Style>

	<Style Selector="Border.badge.danger">
		<Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
	</Style>
	<Style Selector="Border.badge.danger TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
	</Style>

	<Style Selector="Border.badge.info">
		<Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
	</Style>
	<Style Selector="Border.badge.info TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
	</Style>

	<Style Selector="Border.previewRow">
		<Setter Property="Background" Value="{DynamicResource Brush.Input}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Padding" Value="14,12" />
		<Setter Property="Margin" Value="2,0,2,8" />
	</Style>

	<Style Selector="Border.posterFrame">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="2" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="Padding" Value="3" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Button.poster:pointerover Border.posterFrame">
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
	</Style>

	<Style Selector="Border.posterFrame.selected">
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
		<Setter Property="BoxShadow" Value="0 0 0 3 #40528BFF" />
	</Style>

	<Style Selector="Button.poster:pointerover Border.posterFrame.selected">
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
	</Style>

	<Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.12" />
				<BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Button">
		<Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
		<Setter Property="Padding" Value="14,9" />
		<Setter Property="MinHeight" Value="38" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Transitions">
			<Transitions>
				<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Button.chip">
		<Setter Property="Padding" Value="10,5" />
		<Setter Property="MinHeight" Value="30" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Margin" Value="0,0,8,8" />
	</Style>

	<Style Selector="Button.nav">
		<Setter Property="Padding" Value="12,10" />
		<Setter Property="MinHeight" Value="42" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>

	<Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
	</Style>

	<Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
	</Style>

	<Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
	</Style>

	<Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
	</Style>

	<Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
	</Style>

	<Style Selector="Button.nav:disabled PathIcon">
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
	</Style>

	<Style Selector="Button.nav:disabled TextBlock.navIndex">
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
	</Style>

	<Style Selector="Button.nav PathIcon">
		<Setter Property="Width" Value="18" />
		<Setter Property="Height" Value="18" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
	</Style>

	<Style Selector="Button.nav:pointerover PathIcon">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
	</Style>

	<Style Selector="Button.nav.active PathIcon">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
	</Style>

	<Style Selector="Button.nav.active:pointerover PathIcon">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
	</Style>

	<Style Selector="Button.nav TextBlock.navIndex">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
	</Style>

	<Style Selector="Button.nav.active TextBlock.navIndex">
		<Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
	</Style>

	<Style Selector="Button.nav Border.navMark">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Width" Value="3" />
		<Setter Property="Height" Value="16" />
		<Setter Property="CornerRadius" Value="2" />
	</Style>

	<Style Selector="Button.nav.active Border.navMark">
		<Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
	</Style>

	<Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
		<Setter Property="BorderBrush" Value="#66F16D78" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
	</Style>

	<Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
		<Setter Property="Foreground" Value="#2A1216" />
	</Style>

	<Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#D45560" />
		<Setter Property="BorderBrush" Value="#D45560" />
		<Setter Property="Foreground" Value="#2A1216" />
	</Style>

	<Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#2A2226" />
		<Setter Property="BorderBrush" Value="#3A2A2E" />
		<Setter Property="Foreground" Value="#8A7074" />
	</Style>

	<Style Selector="Button.poster">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,0,14,16" />
		<Setter Property="RenderTransform" Value="none" />
	</Style>

	<Style Selector="Button.poster /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style Selector="Button.poster:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
	</Style>

	<Style Selector="Button.poster:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
	</Style>

	<Style Selector="Button.poster:pointerover">
		<Setter Property="RenderTransform" Value="scale(1.025)" />
	</Style>

	<Style Selector="Button.poster:pressed">
		<Setter Property="RenderTransform" Value="scale(0.98)" />
	</Style>

	<Style Selector="TextBox">
		<Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
		<Setter Property="MinHeight" Value="40" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="Normal" />
	</Style>

	<Style Selector="ComboBox">
		<Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
		<Setter Property="MinHeight" Value="40" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="Normal" />
	</Style>

	<Style Selector="CheckBox">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
		<Setter Property="CornerRadius" Value="4" />
	</Style>

	<Style Selector="ProgressBar">
		<Setter Property="Height" Value="6" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
		<Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
	</Style>

	<Style Selector="ToolTip">
		<Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style Selector="ListBox.inset">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style Selector="ListBox.inset ListBoxItem">
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Margin" Value="2,1" />
		<Setter Property="Padding" Value="10,8" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="MinHeight" Value="36" />
	</Style>

	<Style Selector="ListBox.inset ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.12" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="dg|DataGrid">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="RowBackground" Value="Transparent" />
		<Setter Property="RowHeight" Value="46" />
		<Setter Property="ColumnHeaderHeight" Value="40" />
		<Setter Property="GridLinesVisibility" Value="Horizontal" />
		<Setter Property="HorizontalGridLinesBrush" Value="#55303D53" />
		<Setter Property="VerticalGridLinesBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
	</Style>

	<Style Selector="dg|DataGridColumnHeader">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="SeparatorBrush" Value="Transparent" />
	</Style>

	<Style Selector="dg|DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
		<Setter Property="IsVisible" Value="False" />
	</Style>

	<Style Selector="dg|DataGridCell">
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<Style Selector="dg|DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
		<Setter Property="Fill" Value="{DynamicResource Brush.RowHover}" />
		<Setter Property="Opacity" Value="1" />
	</Style>

	<Style Selector="dg|DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
		<Setter Property="Fill" Value="{DynamicResource Brush.RowSelected}" />
		<Setter Property="Opacity" Value="1" />
	</Style>

	<Style Selector="dg|DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
		<Setter Property="Fill" Value="{DynamicResource Brush.RowSelected}" />
		<Setter Property="Opacity" Value="1" />
	</Style>

	<Style Selector="dg|DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
		<Setter Property="Fill" Value="{DynamicResource Brush.RowSelected}" />
		<Setter Property="Opacity" Value="1" />
	</Style>

	<Style Selector="dg|DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
		<Setter Property="Fill" Value="{DynamicResource Brush.RowSelected}" />
		<Setter Property="Opacity" Value="1" />
	</Style>

</Styles>
